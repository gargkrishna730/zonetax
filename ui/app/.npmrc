# Overrides a machine-wide `omit=dev` npm config (would otherwise silently skip installing
# vite/typescript/@vitejs/plugin-react — a fresh `npm install` here produced only 18 packages
# instead of ~38, with tsc/vite simply missing from node_modules/.bin and no error). "false" is
# the valid way to un-omit every dependency class (empty string logs an "invalid config" warning).
omit=false
